#!/usr/bin/env python3
"""Compare two WrathOracle state dumps (wrath-oracle-state-v1) field by field.

usage: oracle/tools/oracle-state-diff A.json B.json [--max N] [--ignore-positions]

Ignored: label, frame, tick, random states, identity (save file and hash), health (but a dump
whose health shows failed records or a changed RNG state makes the comparison fail). Entity
ids present in only one dump (fresh System.Guid ids made during a run) are renamed in order of
first appearance; ids that occur in the save named in the dump's identity (read from the save
folder, read only) are kept. If the save can't be found, ids present in both dumps are kept. Units are
matched by id, list elements by position. Floats compare exactly (both dumps come from the
same build). --ignore-positions also ignores unit position/orientation (T1 values).
Exit 0 if equal, 1 if not.
"""
import json
import re

# Entity ids the game creates during a run are fresh System.Guid values (not from the
# RNG), so two runs give them different names. They are renamed in order of first
# appearance ($new1, $new2, ...) before comparing; save-stable ids (short hex) are kept.
NEWID = re.compile(r'"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"')


def renamer(keep=frozenset()):
    names = {}

    def sub(text):
        return NEWID.sub(lambda m: m.group(0) if m.group(1) in keep else '"' + names.setdefault(m.group(1), f"$new{len(names) + 1}") + '"', text)
    return sub
import sys

TOP_IGNORE = {"label", "frame", "tick", "random_state_before", "random_state_after", "identity", "health"}


def walk(path, a, b, out, ignore_pos):
    if isinstance(a, dict) and isinstance(b, dict):
        for k in sorted(set(a) | set(b)):
            if ignore_pos and k in ("position", "orientation", "m_Orientation", "Position"):
                continue
            if k not in a or k not in b:
                out.append(f"{path}.{k}: only in {'A' if k in a else 'B'}")
            else:
                walk(f"{path}.{k}", a[k], b[k], out, ignore_pos)
    elif isinstance(a, list) and isinstance(b, list):
        if len(a) != len(b):
            out.append(f"{path}: length {len(a)} vs {len(b)}")
        for i, (x, y) in enumerate(zip(a, b)):
            walk(f"{path}[{i}]", x, y, out, ignore_pos)
    elif a != b:
        out.append(f"{path}: {json.dumps(a)[:100]} vs {json.dumps(b)[:100]}")


def main(argv):
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    mx = 40
    ignore_pos = "--ignore-positions" in argv
    if "--max" in argv:
        mx = int(argv[argv.index("--max") + 1])
    import gzip

    def read(p):
        return (gzip.open(p, "rt") if p.endswith(".gz") else open(p)).read()
    ta, tb = read(argv[0]), read(argv[1])
    import os
    import zipfile
    keep = None
    m = re.search(r'"save_file":"([^"]*)"', ta)
    if m:
        path = os.path.join(os.path.expanduser("~/Library/Application Support/Owlcat Games/Pathfinder Wrath Of The Righteous/Saved Games"), os.path.basename(m.group(1)))
        if os.path.isfile(path):
            keep = set()
            with zipfile.ZipFile(path) as z:
                for n in z.namelist():
                    if n.endswith(".json"):
                        keep |= set(re.findall(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", z.read(n).decode("utf-8", "replace")))
    id_policy = "ids from the save kept, ids created during the run renamed" if keep is not None else "save not found: ids in both dumps kept (weaker)"
    if keep is None:
        keep = set(NEWID.findall(ta)) & set(NEWID.findall(tb))
    keep = frozenset(keep)
    a = json.loads(renamer(keep)(ta))
    b = json.loads(renamer(keep)(tb))
    probs = []
    for name, d in (("A", a), ("B", b)):
        h = d.get("health") or {}
        if h.get("records_failed"):
            probs.append(f"{name}: records_failed={h['records_failed']}")
        if h.get("random_state_unchanged") is False or d.get("random_state_before") != d.get("random_state_after"):
            probs.append(f"{name}: the dump changed the RNG state")
    out = []
    for k in sorted(set(a) | set(b)):
        if k in TOP_IGNORE:
            continue
        if k == "units":
            ua = {u.get("id"): u for u in a.get(k, [])}
            ub = {u.get("id"): u for u in b.get(k, [])}
            for uid in sorted(set(ua) | set(ub)):
                if uid not in ua or uid not in ub:
                    out.append(f"units[{uid}]: only in {'A' if uid in ua else 'B'}")
                else:
                    walk(f"units[{uid}]", ua[uid], ub[uid], out, ignore_pos)
        else:
            walk(k, a.get(k), b.get(k), out, ignore_pos)
    print(json.dumps({"valid": not probs, "problems": probs, "id_policy": id_policy, "equal": not out, "differences": len(out), "first": out[:mx],
                      "health": [a.get("health"), b.get("health")]}, indent=1))
    return 0 if not out and not probs else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
